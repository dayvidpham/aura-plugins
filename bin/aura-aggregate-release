#!/usr/bin/env python3
"""Build one immutable nine-cell Aura/Pasture aggregate release directory."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import sys
from dataclasses import dataclass
from enum import Enum
from pathlib import Path
from typing import NoReturn


MANIFEST_NAME = "pasture-aggregate-manifest.json"
CHECKSUM_NAME = f"{MANIFEST_NAME}.sha256"
MANIFEST_SCHEMA = "pasture.aggregate-release/v1"
COMPONENT_SET_SCHEMA = "aura.aggregate-components/v1"
MAX_ASSET_BYTES = 64 << 20
MAX_TOTAL_BYTES = 256 << 20
REVISION_PATTERN = re.compile(r"^[0-9a-f]{40}$")
BUNDLE_PATTERN = re.compile(r"^artifact\.bundle\.v1:sha256:[0-9a-f]{64}$")
VERSION_PATTERN = re.compile(
    r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)"
    r"(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)"
    r"(?:\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?$"
)


class Harness(Enum):
    CLAUDE_CODE = "claude-code"
    OPENCODE = "opencode"
    CODEX = "codex"


class Extension(Enum):
    SKILLS = "skills"
    AGENTS = "agents"
    HOOKS = "hooks"


RUNTIME_CONTRACTS = {
    Harness.CLAUDE_CODE: "claude-code/claude-code@2.1.210",
    Harness.OPENCODE: "opencode/opencode@1.18.10",
    Harness.CODEX: "codex/codex@0.146.0",
}
CANONICAL_CELLS = tuple((harness, extension) for harness in Harness for extension in Extension)


class ContractError(ValueError):
    """An actionable producer-contract validation failure."""


@dataclass(frozen=True)
class Version:
    text: str
    core: tuple[int, int, int]
    prerelease: tuple[str, ...]

    @classmethod
    def parse(cls, text: str, field: str) -> "Version":
        match = VERSION_PATTERN.fullmatch(text)
        if match is None or text.startswith("v") or "+" in text:
            fail(
                f"aggregate generation failed at {field}: {text!r} is not canonical SemVer; "
                "impact: immutable release identity or compatibility cannot be proven; "
                "fix: use MAJOR.MINOR.PATCH with an optional canonical prerelease and no leading v or build metadata"
            )
        return cls(text, tuple(int(match.group(i)) for i in range(1, 4)), tuple((match.group(4) or "").split(".")) if match.group(4) else ())

    def compare(self, other: "Version") -> int:
        if self.core != other.core:
            return -1 if self.core < other.core else 1
        if self.prerelease == other.prerelease:
            return 0
        if not self.prerelease:
            return 1
        if not other.prerelease:
            return -1
        for left, right in zip(self.prerelease, other.prerelease):
            if left == right:
                continue
            left_numeric, right_numeric = left.isdigit(), right.isdigit()
            if left_numeric and right_numeric:
                return -1 if int(left) < int(right) else 1
            if left_numeric != right_numeric:
                return -1 if left_numeric else 1
            return -1 if left < right else 1
        return -1 if len(self.prerelease) < len(other.prerelease) else 1


@dataclass(frozen=True)
class ComponentInput:
    harness: Harness
    extension: Extension
    source: Path
    bundle_id: str

    @property
    def component_id(self) -> str:
        return f"{self.harness.value}/{self.extension.value}"


def fail(message: str) -> NoReturn:
    raise ContractError(message)


def parse_component_set(path: Path) -> list[ComponentInput]:
    def strict_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
        result: dict[str, object] = {}
        for key, value in pairs:
            if key in result:
                fail(
                    f"aggregate generation failed at component set {path}: field {key!r} appears more than once; "
                    "impact: producer input has multiple interpretations; fix: provide each JSON object field exactly once"
                )
            result[key] = value
        return result

    try:
        raw = json.loads(path.read_bytes(), object_pairs_hook=strict_object)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        fail(
            f"aggregate generation failed while reading component set {path}: {error}; "
            "impact: the nine immutable artifacts cannot be identified; "
            "fix: provide one readable UTF-8 JSON component-set document"
        )
    if not isinstance(raw, dict) or set(raw) != {"schema", "components"} or raw.get("schema") != COMPONENT_SET_SCHEMA:
        fail(
            f"aggregate generation failed at component set {path}: expected only schema={COMPONENT_SET_SCHEMA!r} and components; "
            "impact: producer input has ambiguous semantics; fix: use the exact component-set schema"
        )
    records = raw["components"]
    if not isinstance(records, list) or len(records) != len(CANONICAL_CELLS):
        fail(
            f"aggregate generation failed at components: expected exactly nine records, found {len(records) if isinstance(records, list) else 'a non-array'}; "
            "impact: the aggregate would omit or add an installation cell; "
            "fix: provide skills, agents, and hooks for claude-code, opencode, and codex exactly once"
        )
    result: list[ComponentInput] = []
    seen: set[tuple[Harness, Extension]] = set()
    for index, record in enumerate(records):
        if not isinstance(record, dict) or set(record) != {"id", "artifact", "bundle_id"}:
            fail(
                f"aggregate generation failed at components[{index}]: expected exactly id, artifact, and bundle_id; "
                "impact: component identity is ambiguous; fix: remove unknown fields and add every required field"
            )
        try:
            harness_text, extension_text = record["id"].split("/", 1)
            harness, extension = Harness(harness_text), Extension(extension_text)
        except (AttributeError, ValueError):
            fail(
                f"aggregate generation failed at components[{index}].id: {record.get('id')!r} is not a canonical cell; "
                "impact: artifact ownership cannot be proven; fix: use one of the closed nine harness/extension identities"
            )
        coordinate = (harness, extension)
        if coordinate in seen:
            fail(
                f"aggregate generation failed at components[{index}].id: {record['id']!r} is duplicated; "
                "impact: per-cell artifact skew would be ambiguous; fix: provide every canonical cell exactly once"
            )
        seen.add(coordinate)
        bundle_id = record["bundle_id"]
        if not isinstance(bundle_id, str) or BUNDLE_PATTERN.fullmatch(bundle_id) is None:
            fail(
                f"aggregate generation failed at components[{index}].bundle_id: the target-owned bundle identity is malformed; "
                "impact: installed bytes cannot be tied to a target descriptor; "
                "fix: provide artifact.bundle.v1:sha256:<64 lowercase hex> from the Pasture target bundle"
            )
        artifact = record["artifact"]
        if not isinstance(artifact, str) or not artifact:
            fail(
                f"aggregate generation failed at components[{index}].artifact: a non-empty file path is required; "
                "impact: artifact bytes cannot be hashed; fix: provide the built component archive path"
            )
        source = Path(artifact)
        if not source.is_absolute():
            source = path.parent / source
        result.append(ComponentInput(harness, extension, source.absolute(), bundle_id))
    if seen != set(CANONICAL_CELLS):
        missing = ", ".join(f"{h.value}/{e.value}" for h, e in CANONICAL_CELLS if (h, e) not in seen)
        fail(
            f"aggregate generation failed at components: missing canonical cells {missing}; "
            "impact: the aggregate is incomplete; fix: provide all nine cells without fallback or per-cell version selection"
        )
    return sorted(result, key=lambda component: component.component_id)


def read_artifact(component: ComponentInput) -> bytes:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(component.source, flags)
    except OSError as error:
        fail(
            f"aggregate generation failed while opening {component.component_id} artifact {component.source}: {error}; "
            "impact: exact component bytes cannot be frozen; fix: provide a readable, non-symlink regular archive"
        )
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > MAX_ASSET_BYTES:
            fail(
                f"aggregate generation failed at {component.source}: artifact is not a regular file or exceeds {MAX_ASSET_BYTES} bytes; "
                "impact: bounded exact-byte verification is impossible; fix: provide a bounded regular component archive"
            )
        with os.fdopen(descriptor, "rb", closefd=False) as stream:
            content = stream.read(MAX_ASSET_BYTES + 1)
        if len(content) != metadata.st_size or len(content) > MAX_ASSET_BYTES:
            fail(
                f"aggregate generation failed while reading {component.source}: artifact changed or exceeded the byte limit; "
                "impact: its digest is not a stable identity; fix: rebuild the artifact and retry after writers finish"
            )
        return content
    finally:
        os.close(descriptor)


def canonical_asset_name(version: str, component: ComponentInput) -> str:
    harness = "claude" if component.harness is Harness.CLAUDE_CODE else component.harness.value
    return f"pasture-{version}-{harness}-{component.extension.value}.tgz"


def generate(args: argparse.Namespace) -> None:
    version = Version.parse(args.version, "version")
    installer_min = Version.parse(args.installer_min, "installer_min")
    installer_max = Version.parse(args.installer_max, "installer_max")
    if installer_min.compare(installer_max) > 0:
        fail(
            "aggregate generation failed at compatibility: installer-min is greater than installer-max; "
            "impact: no coherent compatible installer range exists; fix: provide an inclusive non-empty range"
        )
    for field, value in (("pasture revision", args.pasture_revision), ("aura revision", args.aura_revision)):
        if REVISION_PATTERN.fullmatch(value) is None:
            fail(
                f"aggregate generation failed at {field}: {value!r} is not an exact lowercase 40-character Git commit; "
                "impact: release provenance would be mutable or ambiguous; fix: provide the exact commit SHA"
            )
    components = parse_component_set(Path(args.components).resolve())
    output = Path(args.output_dir).resolve()
    try:
        output.mkdir(mode=0o755, parents=False, exist_ok=False)
    except OSError as error:
        fail(
            f"aggregate generation failed while claiming output directory {output}: {error}; "
            "impact: an existing immutable aggregate will not be mutated; fix: choose a new empty version-specific output path"
        )
    complete = False
    try:
        records = []
        total = 0
        for component in components:
            content = read_artifact(component)
            total += len(content)
            if total > MAX_TOTAL_BYTES:
                fail(
                    f"aggregate generation failed at component bytes: total exceeds {MAX_TOTAL_BYTES}; "
                    "impact: the aggregate cannot be verified within its bounded contract; fix: reduce component archives"
                )
            asset_name = canonical_asset_name(version.text, component)
            (output / asset_name).write_bytes(content)
            records.append(
                {
                    "id": component.component_id,
                    "harness": component.harness.value,
                    "extension": component.extension.value,
                    "asset": asset_name,
                    "digest": f"sha256:{hashlib.sha256(content).hexdigest()}",
                    "bundle_id": component.bundle_id,
                    "runtime_contract": RUNTIME_CONTRACTS[component.harness],
                    "pasture_revision": args.pasture_revision,
                    "aura_revision": args.aura_revision,
                }
            )
        manifest = {
            "schema": MANIFEST_SCHEMA,
            "version": version.text,
            "channel": "prerelease" if version.prerelease else "final",
            "compatibility": {"installer_min": installer_min.text, "installer_max": installer_max.text},
            "revisions": {"pasture": args.pasture_revision, "aura": args.aura_revision},
            "components": records,
        }
        manifest_bytes = json.dumps(manifest, ensure_ascii=False, separators=(",", ":")).encode() + b"\n"
        (output / MANIFEST_NAME).write_bytes(manifest_bytes)
        digest = hashlib.sha256(manifest_bytes).hexdigest()
        (output / CHECKSUM_NAME).write_text(f"{digest}  {MANIFEST_NAME}\n", encoding="ascii")
        for child in output.iterdir():
            child.chmod(0o444)
        output.chmod(0o555)
        complete = True
    finally:
        if not complete:
            shutil.rmtree(output, ignore_errors=True)


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Build an immutable nine-cell aggregate release without publishing it")
    result.add_argument("--version", required=True, help="canonical aggregate SemVer without a leading v")
    result.add_argument("--installer-min", required=True, help="inclusive minimum compatible Pasture installer SemVer")
    result.add_argument("--installer-max", required=True, help="inclusive maximum compatible Pasture installer SemVer")
    result.add_argument("--pasture-revision", required=True, help="exact 40-character lowercase Pasture commit")
    result.add_argument("--aura-revision", required=True, help="exact 40-character lowercase Aura commit")
    result.add_argument("--components", required=True, help="strict nine-cell component-set JSON path")
    result.add_argument("--output-dir", required=True, help="new version-specific output directory; never overwritten")
    return result


def main() -> int:
    try:
        generate(parser().parse_args())
    except ContractError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
